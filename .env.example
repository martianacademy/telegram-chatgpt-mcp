# Telegram BotFather secret. Never commit the real value.
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOTFATHER_TOKEN

# Separate secret used to protect the MCP endpoint.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Comma-separated Telegram chat IDs/user IDs/channel IDs that this server may access.
# Example: -1001234567890,123456789,@my_public_channel
ALLOWED_CHAT_IDS=-1001234567890

PORT=3000
